<?xml version="1.0" encoding="utf-8"?>
<!-- RumiTX Main Activity: channel list + PTT -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RumiTX"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/active_channel_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No channel selected"
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

    <ListView
        android:id="@+id/channel_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

    <!-- Big PTT button -->
    <Button
        android:id="@+id/ptt_button"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:text="HOLD TO TALK"
        android:textSize="24sp"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/add_channel_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ Channel" />

        <Button
            android:id="@+id/discovery_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Discovery" />
    </LinearLayout>
</LinearLayout>
