<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="#050508">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="R U M I T X    /    2 0 3 0" android:textSize="13sp" android:textColor="#FFB000" android:paddingBottom="2dp"/>
<com.rumitx.app.GlowingFrequencyView android:id="@+id/frequency_display" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—.———— MHz" android:textSize="30sp" android:fontFamily="monospace" android:textColor="#00F0FF" android:shadowColor="#00F0FF" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="10" android:singleLine="true" android:gravity="center"/>
<TextView android:id="@+id/dmr_identity" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:text="DMR IDENTITY · TAP TO SET" android:textColor="#84A9B9" android:textSize="11sp" />
<TextView android:id="@+id/active_channel_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SELECT A CHANNEL" android:textColor="#FFB000" android:textSize="12sp" android:gravity="center" android:padding="3dp"/>
<TextView android:id="@+id/boot_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONNECTING TO RADIO…" android:textSize="10sp" android:textColor="#B5DAE6" android:background="@drawable/holo_panel" android:maxLines="3"/>
<com.rumitx.app.RadioActivityView android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="6dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHANNEL BANK  /  TAP TO TUNE" android:textColor="#84A9B9" android:textSize="10sp" android:letterSpacing="0.12" android:paddingTop="6dp"/>
<ListView android:id="@+id/channel_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:divider="@android:color/transparent" android:dividerHeight="6dp"/>
<com.rumitx.app.HoloPttButton android:id="@+id/ptt_button" android:layout_width="match_parent" android:layout_height="120dp" android:text="HOLD TO TALK"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SQL" android:textColor="#84A9B9"/><SeekBar android:id="@+id/squelch_seek" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:max="9" android:progress="1"/><TextView android:id="@+id/squelch_value" android:layout_width="32dp" android:layout_height="wrap_content" android:text="1" android:textColor="#00F0FF"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp"><Button android:id="@+id/add_channel_btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="+ CHANNEL" android:textSize="9sp" android:letterSpacing="0" android:padding="2dp" android:minWidth="0dp" android:singleLine="true" android:fontFamily="sans-serif-condensed" android:layout_marginEnd="6dp"/><Button android:id="@+id/repeaters_btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="REPEATERS" android:textSize="9sp" android:letterSpacing="0" android:padding="2dp" android:minWidth="0dp" android:singleLine="true" android:fontFamily="sans-serif-condensed" android:layout_marginEnd="6dp"/><Button android:id="@+id/tak_settings_btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="TAK" android:textSize="9sp" android:letterSpacing="0" android:padding="2dp" android:minWidth="0dp" android:singleLine="true" android:layout_marginEnd="6dp"/><Button android:id="@+id/discovery_btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="DISCOVERY" android:textSize="9sp" android:letterSpacing="0" android:padding="2dp" android:minWidth="0dp" android:singleLine="true" android:fontFamily="sans-serif-condensed"/></LinearLayout></LinearLayout>